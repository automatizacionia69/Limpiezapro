# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de Meta (Configuracion basica de la app). Se usa para validar
# la firma X-Hub-Signature-256 de cada webhook entrante. Obligatorio en produccion.
WHATSAPP_APP_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para uso en servidor (webhook, jobs) - NUNCA exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (respaldo del chatbot cuando las reglas de intent.ts no entienden el mensaje)
GEMINI_API_KEY=
# Opcional - default "gemini-flash-latest" en codigo (lib/whatsapp/gemini.ts)
GEMINI_MODEL=
# Opcional - numero de WhatsApp del dueno, para el aviso automatico si Gemini
# falla de forma sostenida (ej. la clave vencio). Si no se configura, el
# aviso simplemente no se envia.
WHATSAPP_ADMIN_NUMERO=
